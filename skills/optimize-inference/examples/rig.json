{
  "schema": 1,
  "platform": {
    "os": "linux",
    "gpu_vendor": "nvidia",
    "gpus": [
      {"index": 0, "name": "NVIDIA RTX A6000", "memory_gib": 48.0},
      {"index": 1, "name": "NVIDIA RTX A6000", "memory_gib": 48.0}
    ],
    "ram_gib": 125.7,
    "cpus": 32,
    "io_schedulers": {"nvme0n1": "none", "sda": "mq-deadline"}
  },
  "collectors": {"gpu": "nvidia-smi", "host": "linux-proc"},
  "checks": {
    "cards_idle":     {"level": "block"},
    "host_ram_floor": {"level": "block", "floor_gib": null},
    "no_build":       {"level": "warn", "names": ["nvcc", "cicc", "ptxas", "ninja", "make", "cargo", "cc1plus"]},
    "on_ac":          {"level": "block"},
    "host_busy":      {"level": "warn", "load_per_cpu": 0.5, "disk_busy_pct": 50}
  },
  "hooks": [
    {"name": "gpu-fan-guard", "cmd": ["systemctl", "is-active", "--quiet", "gpu-fan-guard.service"], "level": "block", "timeout_s": 10}
  ],
  "scope": {
    "build": ["systemd-run", "--user", "--scope", "-q", "-p", "MemoryHigh=113G", "-p", "CPUWeight=10", "nice", "-n", "19"],
    "load": []
  },
  "watchdog": {"no_progress_s": 600},
  "cache_bypass": {"mode": "request_field", "request_field": {"cache_prompt": false}, "flush_cmd": null},
  "noise": {"k": 2.5, "floor_pct": 0.3, "window": 20, "min_samples": 6, "min_tokens": 64, "min_loads": 3, "min_df": 4},
  "settings": {"protected": ["nvidia-smi -pl (power limit)", "nvidia-smi -pm (persistence mode)"], "accepted": []},
  "microbench": {"bw_gbs_by_read_mib": {}, "chain_node_us": null, "link_gbs": null, "peak_tflops_at_cap": null}
}
